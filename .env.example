# 複製成 ezptt.env 後修改；程式會讀取 ./.env 或 -config 指定的檔案。
# 容器部署時由 docker compose 的 env_file 讀取。

# debug / info / warn / error（也接受舊版的 0-3）
LOG_LEVEL=info

# 5 欄（分 時 日 月 週）或 6 欄（秒 分 時 日 月 週）
# 下列表示每天 03:05（容器時區，預設 Asia/Taipei）
CRON_SPEC=5 3 * * *

# 帳號檔（明文 CSV 或加密後的 .enc），一行一個帳號
ACCOUNTS_FILE=/data/PttConfig.csv.enc

# 加密金鑰：二選一。KEY_FILE 指向 0600 的金鑰檔（容器內是唯讀掛載）
KEY_FILE=/run/secrets/key
# ENCRYPTION_KEY=<base64 的 32 bytes 金鑰>

# 同時登入幾個帳號
MAX_CONCURRENCY=2

# 單一帳號的登入逾時 / 等待單一畫面的逾時
LOGIN_TIMEOUT=90s
READ_TIMEOUT=30s

# 登入成功後保持連線的時間，0 表示登入完就斷線
HOLD=0

# 只有主機缺 CA 憑證時才設 true（帳密會失去中間人防護）
INSECURE_TLS=false

# 啟動後先立刻登入一輪，再照 CRON_SPEC 跑（容器重啟就能立即驗證）
RUN_ON_START=false
